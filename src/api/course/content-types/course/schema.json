    "price_v1_section": {
      "type": "component",
      "component": "sections.price-sec-v1",
      "repeatable": false
    },
    "price_sec_v2": {
      "type": "component",
      "component": "sections.price-sec-v2",
      "repeatable": false
    },
    "for_who_section": {
      "type": "component",
      "component": "sections.for-who-sec",
      "repeatable": false
    }
