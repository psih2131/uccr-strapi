      "type": "text"
    },
    "direction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::direction.direction",
      "inversedBy": "courses"
    },
    "category_direction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category-direction.category-direction",
      "inversedBy": "courses"
    },
    "preview": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "popular_courses_add": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::direction.direction",
      "inversedBy": "populars_courses"
