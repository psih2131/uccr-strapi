      "type": "string"
    },
    "form_learning": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "old_price_rub": {
      "type": "integer"
    },
    "default_price": {
      "type": "integer"
    },
    "page_preview": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
